# Environment and configuration files
.env
*.token

# HTML files
IG.html

# Database dumps (contain sensitive data)
# Exception: schema.sql is allowed for documentation
/*.sql
!database/schema.sql

# IDE files
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
logs/
storage/logs/*
!storage/logs/.gitkeep

# Cache and temp files
cache/
tmp/
*.cache
storage/cache/*
!storage/cache/.gitkeep

# Upload directories (may contain sensitive data)
uploads/
storage/uploads/*
!storage/uploads/.gitkeep

# OS files
.DS_Store
Thumbs.db

# Media files
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.ico
*.bmp
*.tiff
*.tif
*.pdf
*.mp4
*.avi
*.mov
*.mp3
*.wav
img/
pdf/
assets/images/*
!assets/images/.gitkeep

# JavaScript - ignore compiled/vendor
assets/js/*.min.js
!assets/js/.gitkeep

# Excel files
*.xlsx
*.xls
