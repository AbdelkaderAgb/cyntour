# Environment and configuration files
.env
*.token

# HTML files
IG.html

# Database dumps (contain sensitive data)
# Exception: schema.sql is allowed for documentation
/*.sql
!database/schema.sql

# IDE files
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
logs/

# Cache and temp files
cache/
tmp/
*.cache

# Upload directories (may contain sensitive data)
uploads/

# OS files
.DS_Store
Thumbs.db

# ===========================================
# Image files - Host on CDN for better performance
# ===========================================
# To remove existing images from git tracking (but keep local files):
# git rm --cached *.jpg *.jpeg *.png *.gif *.webp *.svg
# git rm --cached img/*.jpg img/*.jpeg img/*.png img/*.gif img/*.webp img/*.svg
#
# Uncomment the lines below when ready to use CDN hosting:
# *.jpg
# *.jpeg
# *.png
# *.gif
# *.webp
# *.ico
# img/
# 
# Keep essential images that are part of the application:
# !logo.png
# !logo-mini.png
# !stamp.png
# !singateur.png
